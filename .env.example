# ---- 前端（會被打包進 bundle，僅可放公開值）----
# Supabase project URL，例如 https://abcdefghijkl.supabase.co
VITE_SUPABASE_URL=

# anon public key。此 key 會外流至瀏覽器，安全性完全依賴 RLS（見架構書 §8.1、§16）
VITE_SUPABASE_ANON_KEY=

# 第一期只有一個房間，其 uuid 在種子資料建立後填入（架構書 §7.1 / ADR-0004）
VITE_ROOM_ID=

# ---- 僅供本機腳本與 Edge Function，絕對不可加 VITE_ 前綴、不可進 bundle ----
# service_role key 可繞過所有 RLS
SUPABASE_SERVICE_ROLE_KEY=

# scripts/verify-rls.ts 用來建立各身分的測試帳號。
# 取得位置：Supabase 主控台 → Settings → Database → Connection string。
# **只有在補建開發專案之後才需要填**：正式專案已設 SUPABASE_ENV=production，
# 那支腳本會拒絕執行（ADR-0018）。
SUPABASE_DB_URL=

# ---- 環境護欄 ----
# 設為 production 時，scripts/verify-rls.ts 會拒絕執行。
# 那支腳本會建立與刪除真實的 auth 使用者與貼文，對正式資料庫執行等於直接損毀資料。
# ADR-0018：本專案只有一個 Supabase project，它就是正式環境。
SUPABASE_ENV=

# 給 .github/workflows/cleanup.yml 用，同一個值要設進 Supabase 的 function secret
# 與 GitHub 的 repo secrets。只能觸發 cleanup-posts，不像 service role key 那樣萬能。
CLEANUP_CRON_SECRET=
