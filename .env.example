# ---- 前端（會被打包進 bundle，僅可放公開值）----
# Supabase project URL，例如 https://abcdefghijkl.supabase.co
VITE_SUPABASE_URL=

# anon public key。此 key 會外流至瀏覽器，安全性完全依賴 RLS（見架構書 §8.1、§16）
VITE_SUPABASE_ANON_KEY=

# 第一期只有一個房間，其 uuid 在種子資料建立後填入（架構書 §7.1 / ADR-0004）
VITE_ROOM_ID=

# ---- 僅供本機腳本與 Edge Function，絕對不可加 VITE_ 前綴、不可進 bundle ----
# service_role key 可繞過所有 RLS
SUPABASE_SERVICE_ROLE_KEY=

# scripts/verify-rls.ts 用來建立各身分的測試帳號
SUPABASE_DB_URL=
