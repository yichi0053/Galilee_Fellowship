{
  "name": "galilee-fellowship-wall",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "團契照片牆系統 — 第一期",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:types": "bash scripts/gen-types.sh",
    "verify:rls": "tsx scripts/verify-rls.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@types/node": "^22.20.1",
    "eslint": "^9.12.0",
    "happy-dom": "^15.11.7",
    "supabase": "^2.115.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.8.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
